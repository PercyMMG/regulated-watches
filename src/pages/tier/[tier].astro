---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WatchCard from '../../components/WatchCard.astro';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const all = await getCollection('watches');
  return site.taxonomy.tiers.map((tier) => ({
    params: { tier: tier.id },
    props: { tier, watches: all.filter((w) => w.data.tier === tier.id).sort((a, b) => (a.data.price_value ?? Infinity) - (b.data.price_value ?? Infinity)) },
  }));
}

const { tier, watches } = Astro.props;
---

<Base title={tier.title} description={tier.blurb}>
  <div class="wrap" style="padding-top:44px">
    <p class="eyebrow">Price band</p>
    <h1>{tier.title}</h1>
    <p class="lede">{tier.blurb}</p>

    {watches.length === 0 ? (
      <div class="empty"><p>Nothing in this band yet.</p></div>
    ) : (
      <div class="grid" style="margin-top:28px">
        {watches.map((w, i) => <WatchCard watch={w} eager={i < 3} />)}
      </div>
    )}
  </div>
</Base>
