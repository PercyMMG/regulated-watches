---
import { affiliateLink, hasAssociateTag, searchUrl, site } from '../lib/site';

interface Props {
  watch: { asin?: string; brand?: string; title?: string; model_ref?: string };
  label?: string;
  /** Card variant: full-width button, one-line disclosure instead of a paragraph. */
  compact?: boolean;
}
const { watch, label, compact = false } = Astro.props;

/**
 * Three states, in decreasing order of precision.
 *
 *   1. Tag + ASIN  -> tagged link to the exact product. Earns.
 *   2. ASIN only   -> plain, untagged link to the exact product. Earns nothing,
 *                     but it is an ordinary hyperlink and perfectly fine to
 *                     publish. When the tag is set it becomes state 1 with no
 *                     edit to any content file.
 *   3. Neither     -> plain, untagged Amazon search for the model.
 *
 * The point of states 2 and 3 is that the site can be genuinely useful, and
 * reviewable by Amazon, before an Associates account exists. What it must never
 * do is render a dead control or a link built from a guessed ASIN.
 */
const affiliate = watch.asin ? affiliateLink(watch.asin) : null;
const plainProduct = watch.asin ? `https://www.${site.affiliate.marketplace}/dp/${watch.asin}` : null;

const href = affiliate ?? plainProduct ?? searchUrl(watch);
const isSearch = !watch.asin;

/**
 * Whether this link earns is decided by the tag, not by the destination.
 * searchUrl() carries the tag too once one is configured, so a search link is
 * every bit as much a paid link as a product link and has to be disclosed as
 * one. Deriving this from `affiliate` alone got that wrong for the watches
 * that have no ASIN yet.
 */
const isAffiliate = hasAssociateTag();

const text = label ?? (isSearch ? 'Find on Amazon' : 'Check price on Amazon');

// rel: sponsored only when it actually is. Marking an unpaid link as sponsored
// is inaccurate, and marking a paid one as ordinary is a disclosure failure.
const rel = isAffiliate ? 'nofollow sponsored noopener' : 'nofollow noopener';
---

<a class={compact ? 'buy buy-block' : 'buy'} href={href} rel={rel} target="_blank">{text}</a>

{compact ? (
  /* Disclosure has to sit with the link, not only in the footer. Short on a
     card, but present on every one that earns. */
  <span class="buy-micro">
    {isAffiliate
      ? isSearch ? 'Affiliate link · search' : 'Affiliate link'
      : isSearch ? 'Search, not a specific listing' : 'Ordinary link — earns nothing'}
  </span>
) : (
  <p class="buy-note">
    {isAffiliate
      ? isSearch
        ? `${site.affiliate.disclosureShort} This one goes to an Amazon search rather than a single listing, so check the model reference matches before buying.`
        : site.affiliate.disclosureShort
      : isSearch
        ? 'Search link, not a specific listing. Check the model reference matches before buying.'
        : 'Ordinary link — we earn nothing from it.'}
    {!hasAssociateTag() && <span class="buy-note-admin"> No Associates tag is configured yet.</span>}
  </p>
)}
